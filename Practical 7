;Write X86/64 ALP to convert 4-digit hex number into its equivalent BCD number
Roll No - CO2153
section .data
	msg1 db "Enter 4-digits hex number:",
	len1 equ $-msg1
	msg2 db 10 "Equivalent BCD number:"
	len2 equ $-msg2
	newline db 10
section .bss
	num resb 17		;To store input hex(eg.FFFF)
	bcd resb 10		;To store BCD result 
%macro scall 4
	mov rax, %1
	mov rdi, %2
	mov rsi, %3
	mov rdx, %4
	syscall
%endmacro
section .text
	global _start
_start:
	scall 1, 1, msg1, len1
	scall 0, 0, num, 5
	call ascii_to_hex
	mov rax, rbx
division
	mov rbx, 10
	mov rdi, bcd
	mov rcx,0
loop_bcd:
	mov rdx, 0		;clear remainder register
	div rbx 		;RAX/10 
rdx = remainder			
	push rdx		;store remainder(digits in reverese)
	inc rcx
	jne loop_bcd
display_bcd:
	pop rdx
	add dl, 30h		;Convert to ASCII
	mov [rdi], dl		;store digit present in DL into BCD
	inc rdi			;more pointer
	loop display_bcd	;repeat until all digits printed
	scall 1, 1, msg2, len2
	scall 1, 1, bcd, 5
	mov rax, 60
	mov rdi, rdi
	syscall
ascii_to_hex:
	mov rsi, num
	mov rbx, 0
	mov rcx, 4
loop_hex:
	rol rbx, 4
	mov al, [rsi]
	cmp al, 39h
	jbe skip
	sub al, 07h
skip:
	sub al, 30h
	add bl, al
	inc rsi
	loop loop_hex
	retp
	
 
